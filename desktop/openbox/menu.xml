<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/rc">
  <menu id="root-menu" label="Smash OS">
    <item label="Smash Drums Editor"><action name="Execute"><command>smash editor</command></action></item>
    <item label="Smash Hub"><action name="Execute"><command>smash hub</command></action></item>
    <item label="Indies-DB"><action name="Execute"><command>smash browser</command></action></item>
    <item label="Charts folder"><action name="Execute"><command>thunar ~/Charts</command></action></item>
    <separator/>
    <item label="New project…"><action name="Execute"><command>x-terminal-emulator -e bash -lc 'read -p "Title: " t; smash new "$t"; read -p "Enter…"'</command></action></item>
    <item label="Terminal"><action name="Execute"><command>x-terminal-emulator</command></action></item>
    <item label="Doctor"><action name="Execute"><command>x-terminal-emulator -e bash -lc 'smash doctor; read -p "Enter…"'</command></action></item>
    <separator/>
    <item label="Reconfigure Openbox"><action name="Reconfigure"/></item>
    <item label="Log out"><action name="Exit"><prompt>yes</prompt></action></item>
  </menu>
</openbox_menu>
